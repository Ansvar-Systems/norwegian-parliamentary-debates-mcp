# ═══════════════════════════════════════════════════════════════════════════
# GIT IGNORE
# ═══════════════════════════════════════════════════════════════════════════

# ───────────────────────────────────────────────────────────────────────────
# NODE
# ───────────────────────────────────────────────────────────────────────────

# Dependencies
node_modules/

# Build output
dist/

# Test coverage
coverage/

# npm debug logs
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# ───────────────────────────────────────────────────────────────────────────
# DATA
# ───────────────────────────────────────────────────────────────────────────

# Database — build artifact, regenerated at deploy time
data/*.db
data/*.db-journal
data/*.db-wal
data/*.db-shm

# Seed JSON files (thousands of per-session speech files, 59 MB)
data/seed/

# Cache / corpus downloads (ParlaMint-NO archive, ~400 MB)
data/cache/

# Generated build artifacts in data/
data/census.json
data/eu-references-analysis.json
data/relevant-statutes.json
data/validation-statutes.json

# Source data downloads (if any)
data/*.csv
data/*.json.gz
data/*.zip
data/*.tgz
data/*.tar.gz

# ───────────────────────────────────────────────────────────────────────────
# ENVIRONMENT
# ───────────────────────────────────────────────────────────────────────────

# Environment variables
.env
.env.local
.env.*.local

# ───────────────────────────────────────────────────────────────────────────
# IDE
# ───────────────────────────────────────────────────────────────────────────

# VS Code
.vscode/
*.code-workspace

# JetBrains (WebStorm, IntelliJ)
.idea/
*.iml

# Vim
*.swp
*.swo
*~

# ───────────────────────────────────────────────────────────────────────────
# OS
# ───────────────────────────────────────────────────────────────────────────

# macOS
.DS_Store
.AppleDouble
.LSOverride
._*

# Windows
Thumbs.db
ehthumbs.db
Desktop.ini

# Linux
*~

# ───────────────────────────────────────────────────────────────────────────
# MISC
# ───────────────────────────────────────────────────────────────────────────

# TypeScript incremental compilation
*.tsbuildinfo

# Lock files (keep package-lock.json, ignore others)
yarn.lock
pnpm-lock.yaml

# Logs
logs/

# Temporary files
tmp/
temp/
*.tmp
.serena/
.claude/
.vercel
database.db
reports/
